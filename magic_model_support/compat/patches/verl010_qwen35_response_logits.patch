+                # Qwen3.5 exposes the official ``logits_to_keep`` forward argument.
+                # MAGIC only trains on response tokens, so materializing the LM head
+                # for every prompt token wastes tens of GiB on long contexts.  Keep
+                # the smallest shared position interval covering every response in
+                # this dynamic micro-batch; prepare_model_outputs slices each sample
+                # back to its exact response range below.
+                if os.environ.get("MAGIC_RESPONSE_ONLY_LOGITS") == "1":
+                    prompts = micro_batch["prompts"]
+                    responses = micro_batch["responses"]
+                    if prompts.is_nested:
+                        prompt_lengths_tensor = prompts.offsets().diff()
+                        response_lengths_tensor = responses.offsets().diff()
+                    else:
+                        attention_mask = micro_batch["attention_mask"]
+                        prompt_width = prompts.shape[1]
+                        prompt_lengths_tensor = attention_mask[:, :prompt_width].sum(dim=1)
+                        response_lengths_tensor = attention_mask[:, prompt_width:].sum(dim=1)
+                    prompt_lengths = [int(value) for value in prompt_lengths_tensor.cpu().tolist()]
+                    response_lengths = [int(value) for value in response_lengths_tensor.cpu().tolist()]
+                    if any(length <= 0 for length in prompt_lengths + response_lengths):
+                        raise RuntimeError(
+                            "MAGIC response-only logits require non-empty prompts and responses, got "
+                            f"prompt_lengths={prompt_lengths}, response_lengths={response_lengths}"
+                        )
+                    keep_start = min(length - 1 for length in prompt_lengths)
+                    keep_stop = max(
+                        prompt_length + response_length - 1
+                        for prompt_length, response_length in zip(prompt_lengths, response_lengths, strict=True)
+                    )
+                    model_inputs["logits_to_keep"] = torch.arange(
+                        keep_start,
+                        keep_stop,
+                        device=input_ids.device,
+                        dtype=torch.long,
+                    )
+                    output_args["magic_response_logit_start"] = keep_start
+                    output_args["magic_prompt_lengths"] = prompt_lengths
+                    output_args["magic_response_lengths"] = response_lengths
 
