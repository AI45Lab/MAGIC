{
  "model_family": "ministral",
  "model_path": "/models/Ministral-3-14B-Reasoning-2512",
  "train_file": "/data/sft-train.json",
  "validation_file": "/data/sft-validation.json",
  "max_length": 2048,
  "training_args": {
    "output_dir": "/runs/ministral-sft",
    "learning_rate": 1e-05,
    "num_train_epochs": 3,
    "per_device_train_batch_size": 1,
    "per_device_eval_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "bf16": true,
    "gradient_checkpointing": true,
    "gradient_checkpointing_kwargs": {
      "use_reentrant": false
    },
    "eval_strategy": "epoch",
    "save_strategy": "epoch",
    "report_to": "none",
    "fsdp": "full_shard auto_wrap",
    "fsdp_config": {
      "transformer_layer_cls_to_wrap": [
        "Ministral3DecoderLayer"
      ],
      "use_orig_params": true
    }
  }
}
